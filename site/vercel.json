{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/guides",
      "destination": "/guides.html"
    }
  ],
  "headers": [
    {
      "source": "/n/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
